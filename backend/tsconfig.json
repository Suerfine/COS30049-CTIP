{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
}
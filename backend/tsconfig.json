{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
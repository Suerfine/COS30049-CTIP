PORT = 5000
SHOULD_INSTRUMENT_ROUTES = false

# Authentication settings
JWT_SECRET=change_me_in_production

#Storage settings
PUBLIC_STORAGE_PATH = "storage/public"
PRIVATE_STORAGE_PATH = "storage/private"

# USER Profile Picture (PFP) settings
PFP_MAX_FILE_SIZE = 2097152
PFP_MAX_WIDTH = 512
PFP_MAX_HEIGHT = 512

# MQTT Configuration
# Set your MQTT broker URL here
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883

# Topics to subscribe to (comma-separated)
MQTT_TOPICS=forest/zone1/sensorlog

# Enable or disable MQTT integration
ENABLE_MQTT=true

# Optional: MQTT authentication (if your broker requires it)
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# AI Chatbot API configuration(s)
GEMINI_API_KEY = "your_gemini_api_key_here"

# email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=faizhalek17@gmail.com
SMTP_PASS=yooiwdpntozoxtpw
SMTP_FROM="SFC Training Portal <faizhalek17@gmail.com>"
# FRONTEND_URL=https://localhost:8443 (use only when https is properly configured)
FRONTEND_URL=http://localhost:8081
PORT = 5000
SHOULD_INSTRUMENT_ROUTES = false

# ===============================
# HTTPS/TLS settings
# ===============================
# For LAN access from other devices, generate a cert that includes your machine's IP:
#   mkcert <YOUR_LAN_IP> localhost 127.0.0.1
# This produces certs/<IP>+2.pem and certs/<IP>+2-key.pem — update the paths below.
# The other device must also run: mkcert -install
# If want to use HTTP instead, set HTTPS_ENABLED to false and FORCE_HTTPS_REDIRECT to false.
HTTPS_ENABLED = true
HTTPS_KEY_PATH = certs/server.key
HTTPS_CERT_PATH = certs/server.crt
# HTTPS_CA_PATH = certs/ca-chain.pem
FORCE_HTTPS_REDIRECT = true

# ===============================
# Authentication settings
# ===============================
JWT_SECRET=change_me_in_production

#Storage settings
PUBLIC_STORAGE_PATH = "storage/public"
PRIVATE_STORAGE_PATH = "storage/private"

# ===============================
# Email settings
# ===============================
# For testing, you can use Ethereal Email (https://ethereal.email/) to get fake SMTP credentials and view sent emails in their web interface.
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER = SFC_CTIP_PORTAL_EMAIL
SMTP_PASS = SFC_CTIP_PORTAL_EMAIL_APPPASSWORD
SMTP_FROM = "SFC Training Portal <no-reply@sfc.gov.my>"
FRONTEND_URL = https://localhost:8443 

# USER Profile Picture (PFP) settings
PFP_MAX_FILE_SIZE = 2097152
PFP_MAX_WIDTH = 512
PFP_MAX_HEIGHT = 512

# ===============================
# MQTT Configuration
# ===============================
# Set your MQTT broker URL here
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPICS=forest/zone1/sensorlog
ENABLE_MQTT=true
# Optional: MQTT authentication (if your broker requires it)
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# AI Chatbot API configuration(s)
GEMINI_API_KEY = "your_gemini_api_key_here"
